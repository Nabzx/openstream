{
  "name": "openstream",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first voice dictation for macOS, built for developers.",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run",
    "prepare:model-artifacts": "node scripts/prepare-model-artifacts.mjs",
    "build:whisper": "bash scripts/build-whisper.sh",
    "postinstall": "npm run prepare:model-artifacts",
    "start": "cross-env NODE_ENV=production electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^4.1.11",
    "wait-on": "^7.2.0"
  }
}
