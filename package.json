{
  "name": "openstream",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Local-first voice dictation for macOS, built for developers.",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "prepare:electron": "node node_modules/electron/install.js",
    "prepare:model-artifacts": "node scripts/prepare-model-artifacts.mjs",
    "build:whisper": "bash scripts/build-whisper.sh",
    "build:hotkey-helper": "bash scripts/build-hotkey-helper.sh",
    "build:accessibility-helper": "bash scripts/build-accessibility-helper.sh",
    "build:llama": "bash scripts/fetch-llama.sh",
    "postinstall": "npm run prepare:electron && npm run prepare:model-artifacts && npm run build:hotkey-helper && npm run build:accessibility-helper && npm run build:llama",
    "start": "cross-env NODE_ENV=production electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test \"electron/**/*.test.js\"",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --publish=never"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^4.1.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.openstream.app",
    "productName": "OpenStream",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources", "to": "resources" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    }
  }
}
