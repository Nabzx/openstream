# Node / Electron
node_modules/
dist/
dist-electron/
release/
.vite/

# Native helper build output (Swift/Obj-C binaries, compiled via native build scripts)
build/
.build/
*.xcuserstate
DerivedData/

# macOS
.DS_Store

# Downloaded binaries and models (fetched by download scripts, not checked in)
resources/bin/
*.gguf
*.bin
*.mlmodelc

# Vendored source cloned by build scripts (e.g. whisper.cpp), not checked in
vendor/

# Environment / secrets
.env
.env.local

# Claude Code local worktrees and session state
.claude/

# Python spike scratch
__pycache__/
*.pyc

# Prototype / spike run output - machine-generated benchmark logs and result
# dumps. Only the curated README.md / RESULTS.md prose is checked in; the raw
# artifacts leak local paths and hardware detail and have no lasting value.
prototypes/**/logs/
prototypes/**/out/
spike/**/logs/
spike/**/out/
*.trace

# Screen-recording sources - only the optimised assets/demo.{gif,mp4} are committed
assets/*.mov
